    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
