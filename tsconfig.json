{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/preload/**/*.d.ts",
    "src/core/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
